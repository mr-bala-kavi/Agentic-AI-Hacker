# LLM provider is OPTIONAL. Default "heuristic" needs no key and runs offline.
LLM_PROVIDER=heuristic          # heuristic | openai | anthropic
LLM_MODEL=                      # e.g. gpt-4o-mini or claude-sonnet-5
# Never commit real keys. These are read from the environment only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Engine tuning
REQUEST_TIMEOUT=15
MAX_TEST_ITERATIONS=200
APPROVAL_MODE=auto-safe         # auto-safe | manual
